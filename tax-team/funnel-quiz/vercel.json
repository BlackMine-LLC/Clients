{
    "functions": {
          "api/submit.js": {
                  "memory": 128,
                  "maxDuration": 10
          }
    },
    "routes": [
          {
                  "src": "/api/submit",
                  "dest": "/api/submit.js"
          },
          {
                  "src": "/(.*)",
                  "dest": "/index.html"
          }
    ]
}
